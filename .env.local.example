NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used for Paystack's callback_url after checkout. Defaults to
# localhost:3000 in code if unset -- set this to the real deployed URL
# once there is one.
NEXT_PUBLIC_SITE_URL=

# Paystack test/sandbox secret key. Until this is set, the "Pay" button
# on the organizer dashboard shows a friendly error and competitions can
# only be published via an Admin waiver.
PAYSTACK_SECRET_KEY=

# Twilio Auth Token, used to verify the X-Twilio-Signature header on
# inbound WhatsApp webhooks (app/api/webhooks/whatsapp). Without it, the
# webhook route rejects every request rather than skipping verification.
TWILIO_AUTH_TOKEN=
